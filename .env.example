# ============================================================
#  Configuration Myra Skin Care — Backend
#  Copier ce fichier en .env et renseigner les vraies valeurs.
# ============================================================

# Serveur
PORT=4000
NODE_ENV=development
# URL du site front (pour CORS) — ex. http://localhost:5173 en dev
FRONTEND_URL=http://localhost:5173
# URL publique du backend (pour construire les liens d'images)
BACKEND_URL=http://localhost:4000

# Logs (Pino)
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myra
DB_USER=postgres
DB_PASSWORD=motdepasse

# Authentification admin (admin unique au démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe
# Clé secrète pour signer les tokens JWT (chaîne longue et aléatoire)
JWT_SECRET=remplacez-par-une-chaine-secrete-longue-et-aleatoire
JWT_EXPIRES_IN=7d

# API WhatsApp Evolution (déjà hébergée sur votre serveur)
WHATSAPP_API_URL=https://votre-serveur-evolution.example.com
WHATSAPP_API_KEY=votre-cle-api-evolution
WHATSAPP_INSTANCE=myra

# Délai d'expiration d'une commande impayée (en heures)
ORDER_EXPIRATION_HOURS=48
